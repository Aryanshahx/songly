echo "==> Patching AndroidManifest for INTERNET permission"
python3 - <<'SONGLY_EOF'
import os
p = 'android/app/src/main/AndroidManifest.xml'
if not os.path.exists(p):
    print('    manifest not found, skipping (run flutter create . if needed)')
else:
    s = open(p).read()
    if 'android.permission.INTERNET' in s:
        print('    INTERNET permission already present')
    else:
        s = s.replace('<application',
              '    <uses-permission android:name="android.permission.INTERNET"/>\n\n    <application', 1)
        open(p, 'w').write(s)
        print('    added INTERNET permission (release APKs need this explicitly!)')
SONGLY_EOF

