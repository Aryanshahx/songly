import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../../app/theme/app_theme.dart';
import '../../../core/config/env.dart';
import '../../../core/network/dio_client.dart';
import '../../../core/network/quota_ledger.dart';
import '../../../core/storage/hive_boxes.dart';

/// M0 smoke test screen: if this renders real numbers, then Env (--dart-define),
/// Hive, Riverpod providers and the router are all wired correctly.
class SettingsScreen extends ConsumerStatefulWidget {
  const SettingsScreen({super.key});

  @override
  ConsumerState<SettingsScreen> createState() => _SettingsScreenState();
}

class _SettingsScreenState extends ConsumerState<SettingsScreen> {
  @override
  Widget build(BuildContext context) {
    final QuotaLedger ledger = ref.watch(quotaLedgerProvider);

    return Scaffold(
      appBar: AppBar(title: const Text('Settings')),
      body: ListView(
        children: <Widget>[
          _Header('YouTube lookup budget'),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: <Widget>[
                ClipRRect(
                  borderRadius: BorderRadius.circular(8),
                  child: LinearProgressIndicator(
                    value: ledger.searchFraction,
                    minHeight: 10,
                    backgroundColor: AppColors.surfaceHigh,
                    color: ledger.canSearch ? AppColors.accent : AppColors.danger,
                  ),
                ),
                const SizedBox(height: 8),
                Text(
                  '${ledger.searchesToday} of ${ledger.searchCap} searches used today  '
                  '(${ledger.unitsToday} cheap units)',
                  style: const TextStyle(color: AppColors.textDim, fontSize: 12.5),
                ),
                const SizedBox(height: 6),
                const Text(
                  'Searches are the scarce resource. Songly resolves whole artist '
                  'catalogues with 1-unit calls and caches every match forever, so '
                  'most playback costs nothing.',
                  style: TextStyle(color: AppColors.textDim, fontSize: 12),
                ),
              ],
            ),
          ),
          const SizedBox(height: 8),
          ListTile(
            leading: const Icon(Icons.key_rounded),
            title: const Text('YouTube API key'),
            subtitle: Text(
              Env.hasYouTubeKey
                  ? 'Loaded from build config'
                  : 'Missing - add it to dart_define.json',
            ),
            trailing: Icon(
              Env.hasYouTubeKey ? Icons.check_circle_rounded : Icons.error_rounded,
              color: Env.hasYouTubeKey ? AppColors.accent : AppColors.danger,
            ),
          ),
          const Divider(),
          _Header('Storage'),
          for (final String name in HiveBoxes.all)
            ListTile(
              dense: true,
              leading: const Icon(Icons.storage_rounded, size: 18),
              title: Text(name),
              trailing: Text('${HiveBoxes.box(name).length}'),
            ),
          ListTile(
            leading: const Icon(Icons.cleaning_services_rounded),
            title: const Text('Clear caches'),
            subtitle: Text('${cachedResponseCount()} cached responses'),
            onTap: () async {
              await HiveBoxes.clearCaches();
              if (!mounted) return;
              setState(() {});
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(content: Text('Caches cleared')),
              );
            },
          ),
          const Divider(),
          _Header('About'),
          ListTile(
            leading: const Icon(Icons.info_outline_rounded),
            title: const Text('Songly'),
            subtitle: Text(
              'v${Env.appVersion}\nMetadata by MusicBrainz - playback via the '
              'YouTube iFrame Player.',
            ),
          ),
          const ListTile(
            leading: Icon(Icons.visibility_outlined),
            title: Text('Playback stays on screen'),
            subtitle: Text(
              'Songly plays through YouTube, so the player must stay visible. '
              'Picture-in-picture support arrives in M7 for multitasking.',
            ),
          ),
          const SizedBox(height: 32),
        ],
      ),
    );
  }
}

class _Header extends StatelessWidget {
  const _Header(this.text);

  final String text;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(16, 20, 16, 10),
