import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../../app/theme/app_theme.dart';
import '../../../core/utils/debouncer.dart';
import '../../../shared/widgets/state_views.dart';

class SearchScreen extends ConsumerStatefulWidget {
  const SearchScreen({super.key});

  @override
  ConsumerState<SearchScreen> createState() => _SearchScreenState();
}

class _SearchScreenState extends ConsumerState<SearchScreen> {
  final TextEditingController _controller = TextEditingController();
  final Debouncer _debouncer = Debouncer();
  String _query = '';

  @override
  void dispose() {
    _controller.dispose();
    _debouncer.dispose();
    super.dispose();
  }

  void _onChanged(String value) {
    // 400ms debounce kills ~80% of would-be MusicBrainz calls. M1 hooks this
    // up to the real search provider.
    _debouncer.run(() {
      if (mounted) setState(() => _query = value.trim());
    });
  }

  @override
  Widget build(BuildContext context) {
    return SafeArea(
      child: Column(
        children: <Widget>[
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 8),
            child: TextField(
              controller: _controller,
              onChanged: _onChanged,
              textInputAction: TextInputAction.search,
              decoration: InputDecoration(
                hintText: 'Songs, artists or albums',
                prefixIcon: const Icon(Icons.search_rounded),
                suffixIcon: _controller.text.isEmpty
                    ? null
                    : IconButton(
                        icon: const Icon(Icons.close_rounded),
                        onPressed: () {
                          _controller.clear();
                          _onChanged('');
                        },
                      ),
              ),
            ),
          ),
          Expanded(
            child: _query.isEmpty
                ? const EmptyView(
                    icon: Icons.travel_explore_rounded,
                    title: 'Search MusicBrainz',
                    subtitle:
                        'Millions of songs, artists and albums.\nSearch wiring lands in M1.',
                  )
                : ListView(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    children: <Widget>[
                      Text(
                        'Results for "$_query"',
                        style: const TextStyle(color: AppColors.textDim),
                      ),
                      const SizedBox(height: 16),
                      for (int i = 0; i < 8; i++)
                        const Padding(
                          padding: EdgeInsets.only(bottom: 14),
                          child: Row(
                            children: <Widget>[
                              ShimmerBox(width: 52, height: 52, radius: 8),
                              SizedBox(width: 12),
                              Expanded(
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: <Widget>[
                                    ShimmerBox(height: 13),
                                    SizedBox(height: 8),
                                    ShimmerBox(width: 120, height: 11),
                                  ],
                                ),
                              ),
                            ],
                          ),
                        ),
                    ],
                  ),
          ),
        ],
      ),
    );
  }
}
SONGLY_EOF

