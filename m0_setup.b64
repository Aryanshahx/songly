echo "    lib/core/config/env.dart"
cat > lib/core/config/env.dart <<'SONGLY_EOF'
/// Compile-time configuration.
///
/// Values arrive via `--dart-define-from-file=dart_define.json` locally and via
/// Codemagic environment variables in CI. Nothing secret is hardcoded here.
class Env {
  const Env._();

  static const String ytApiKey = String.fromEnvironment('YT_API_KEY');
  static const String mbContact =
      String.fromEnvironment('MB_CONTACT', defaultValue: 'songly@example.com');
  static const String appVersion =
      String.fromEnvironment('APP_VERSION', defaultValue: '1.0.0');

  /// Point this at http://localhost:8787 to use tools/mb_proxy.dart during web
  /// development on the Pi (browsers cannot set a User-Agent header).
  static const String mbBaseUrl = String.fromEnvironment(
    'MB_BASE_URL',
    defaultValue: 'https://musicbrainz.org/ws/2',
  );

  static const String ytBaseUrl = 'https://www.googleapis.com/youtube/v3';
  static const String coverArtBaseUrl = 'https://coverartarchive.org';
  static const String lyricsBaseUrl = 'https://lrclib.net/api';
  static const String listenBrainzBaseUrl = 'https://labs.api.listenbrainz.org';

  static bool get hasYouTubeKey => ytApiKey.isNotEmpty;

  /// MusicBrainz REQUIRES a descriptive User-Agent with contact info.
  static String get userAgent => 'Songly/$appVersion ( $mbContact )';
}
SONGLY_EOF

echo "    lib/core/errors/failure.dart"
cat > lib/core/errors/failure.dart <<'SONGLY_EOF'
import 'package:dio/dio.dart';

sealed class Failure implements Exception {
  const Failure(this.message);
  final String message;

  @override
  String toString() => '$runtimeType: $message';

  static Failure from(Object error) {
    if (error is Failure) return error;
    if (error is DioException) {
      final int? code = error.response?.statusCode;
      if (code == 503 || code == 429) {
        return const RateLimitFailure(
          'The music database is busy. Trying again shortly.',
        );
      }
      if (code == 403) {
        final String body = error.response?.data?.toString() ?? '';
        if (body.contains('quotaExceeded') || body.contains('quota')) {
          return const QuotaFailure(
            'Daily YouTube lookup limit reached. Cached songs still play.',
          );
        }
        return const UnknownFailure('Access denied by the service (403).');
      }
      if (code == 404) return const NotFoundFailure('Not found.');
      return switch (error.type) {
        DioExceptionType.connectionTimeout ||
        DioExceptionType.receiveTimeout ||
        DioExceptionType.sendTimeout =>
          const NetworkFailure('Connection timed out.'),
        DioExceptionType.connectionError =>
          const NetworkFailure('No internet connection.'),
        _ => UnknownFailure(error.message ?? 'Something went wrong.'),
      };
    }
    return UnknownFailure(error.toString());
  }
}

class NetworkFailure extends Failure {
  const NetworkFailure(super.message);
}

class RateLimitFailure extends Failure {
  const RateLimitFailure(super.message);
}

class QuotaFailure extends Failure {
  const QuotaFailure(super.message);
}

class NotFoundFailure extends Failure {
  const NotFoundFailure(super.message);
}

class UnknownFailure extends Failure {
  const UnknownFailure(super.message);
}
SONGLY_EOF

echo "    lib/core/network/dio_client.dart"
cat > lib/core/network/dio_client.dart <<'SONGLY_EOF'
import 'package:dio/dio.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../config/env.dart';
import '../storage/hive_boxes.dart';
import 'hive_cache_interceptor.dart';
import 'rate_limit_interceptor.dart';
import 'user_agent_interceptor.dart';

/// MusicBrainz client: User-Agent -> cache -> rate limit -> backoff.
/// Order matters: the cache runs BEFORE the rate limiter, so cache hits are
/// instant instead of waiting in the 1 req/s queue.
final Provider<Dio> mbDioProvider = Provider<Dio>((ref) {
  final Dio dio = Dio(
    BaseOptions(
      baseUrl: Env.mbBaseUrl,
      connectTimeout: const Duration(seconds: 12),
      receiveTimeout: const Duration(seconds: 20),
      queryParameters: <String, dynamic>{'fmt': 'json'},
      headers: <String, dynamic>{'Accept': 'application/json'},
      responseType: ResponseType.json,
    ),
  );
  dio.interceptors.addAll(<Interceptor>[
    UserAgentInterceptor(),
    HiveCacheInterceptor(ttl: const Duration(days: 30)),
    RateLimitInterceptor(),
    BackoffInterceptor(),
  ]);
  return dio;
});

/// YouTube Data API client. Cache TTL is deliberately huge: a videoId for a
/// song does not change, so we should never pay for the same lookup twice.
final Provider<Dio> ytDioProvider = Provider<Dio>((ref) {
  final Dio dio = Dio(
    BaseOptions(
      baseUrl: Env.ytBaseUrl,
      connectTimeout: const Duration(seconds: 12),
      receiveTimeout: const Duration(seconds: 20),
      responseType: ResponseType.json,
    ),
  );
  dio.interceptors.addAll(<Interceptor>[
    HiveCacheInterceptor(ttl: const Duration(days: 365)),
    BackoffInterceptor(maxRetries: 1),
  ]);
  return dio;
});

/// Plain client for Cover Art Archive / LRCLIB / ListenBrainz.
final Provider<Dio> plainDioProvider = Provider<Dio>((ref) {
  final Dio dio = Dio(
    BaseOptions(
      connectTimeout: const Duration(seconds: 12),
      receiveTimeout: const Duration(seconds: 20),
    ),
  );
  dio.interceptors.addAll(<Interceptor>[
    UserAgentInterceptor(),
    HiveCacheInterceptor(ttl: const Duration(days: 14)),
  ]);
  return dio;
});

/// Convenience so features can read cache stats without touching Hive.
int cachedResponseCount() => HiveBoxes.box(HiveBoxes.httpCache).length;
SONGLY_EOF

echo "    lib/core/network/hive_cache_interceptor.dart"
cat > lib/core/network/hive_cache_interceptor.dart <<'SONGLY_EOF'
import 'dart:convert';

import 'package:dio/dio.dart';
import 'package:hive_ce_flutter/hive_ce_flutter.dart';

import '../storage/hive_boxes.dart';

/// Disk cache for GET requests.
///
/// Three jobs:
///  1. Serve fresh cached responses instantly (and skip the rate limiter).
///  2. Save MusicBrainz from repeat calls - MBID data barely ever changes.
///  3. Serve STALE data when the network fails, so the app works offline.
class HiveCacheInterceptor extends Interceptor {
  HiveCacheInterceptor({
    this.boxName = HiveBoxes.httpCache,
    this.ttl = const Duration(days: 30),
  });

  final String boxName;
  final Duration ttl;

  Box<dynamic> get _box => HiveBoxes.box(boxName);

  String _key(RequestOptions o) => o.uri.toString();

  @override
  void onRequest(RequestOptions options, RequestInterceptorHandler handler) {
    if (options.method != 'GET' || options.extra['no_cache'] == true) {
      handler.next(options);
      return;
    }

    final Map<dynamic, dynamic>? entry =
        _box.get(_key(options)) as Map<dynamic, dynamic>?;
    if (entry != null) {
      final int ts = (entry['ts'] as int?) ?? 0;
      final bool fresh = DateTime.now()
              .difference(DateTime.fromMillisecondsSinceEpoch(ts)) <
          ttl;
      if (fresh) {
        handler.resolve(
          Response<dynamic>(
            requestOptions: options,
            statusCode: 200,
            data: jsonDecode(entry['body'] as String),
            extra: <String, dynamic>{'from_cache': true},
          ),
        );
        return;
      }
    }
    handler.next(options);
  }

  @override
  void onResponse(
    Response<dynamic> response,
    ResponseInterceptorHandler handler,
  ) {
    final bool cacheable = response.requestOptions.method == 'GET' &&
        response.statusCode == 200 &&
        response.extra['from_cache'] != true &&
        (response.data is Map || response.data is List);

    if (cacheable) {
      _box.put(_key(response.requestOptions), <String, dynamic>{
        'ts': DateTime.now().millisecondsSinceEpoch,
        'body': jsonEncode(response.data),
      });
    }
    handler.next(response);
  }

  @override
  void onError(DioException err, ErrorInterceptorHandler handler) {
    final Map<dynamic, dynamic>? entry =
        _box.get(_key(err.requestOptions)) as Map<dynamic, dynamic>?;
    if (entry != null) {
      handler.resolve(
        Response<dynamic>(
          requestOptions: err.requestOptions,
          statusCode: 200,
          data: jsonDecode(entry['body'] as String),
          extra: <String, dynamic>{'from_cache': true, 'stale': true},
        ),
      );
      return;
    }
    handler.next(err);
  }
}
SONGLY_EOF

echo "    lib/core/network/quota_ledger.dart"
cat > lib/core/network/quota_ledger.dart <<'SONGLY_EOF'
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:hive_ce_flutter/hive_ce_flutter.dart';

import '../storage/hive_boxes.dart';

/// Tracks what we spend on the YouTube Data API so the app degrades with a
/// clear message instead of dying on a 403.
///
/// Reminder of the economics:
///   search.list      = 100 units (own ~100 call/day bucket) -> SCARCE
///   videos.list      = 1 unit    -> cheap
///   channels.list    = 1 unit    -> cheap
///   playlistItems    = 1 unit / 50 videos -> how we harvest whole catalogues
class QuotaLedger {
  QuotaLedger(this._box);

  final Box<dynamic> _box;

  static const int defaultSearchCap = 30;
  static const int searchUnitCost = 100;
  static const int dailyUnitPool = 10000;

  static String dayKey([DateTime? at]) {
    final DateTime d = at ?? DateTime.now();
    final String m = d.month.toString().padLeft(2, '0');
    final String day = d.day.toString().padLeft(2, '0');
    return '${d.year}-$m-$day';
  }

  int get searchCap =>
      (HiveBoxes.box(HiveBoxes.settings).get('search_cap') as int?) ??
      defaultSearchCap;

  int get searchesToday => (_box.get('s_${dayKey()}') as int?) ?? 0;
  int get unitsToday => (_box.get('u_${dayKey()}') as int?) ?? 0;

  bool get canSearch => searchesToday < searchCap;
  int get searchesLeft => (searchCap - searchesToday).clamp(0, searchCap);

  double get searchFraction =>
      searchCap == 0 ? 1 : (searchesToday / searchCap).clamp(0.0, 1.0);

  Future<void> spendSearch([int n = 1]) =>
      _box.put('s_${dayKey()}', searchesToday + n);

  Future<void> spendUnits(int n) => _box.put('u_${dayKey()}', unitsToday + n);

  /// Called when Google returns 403 quotaExceeded: stop trying today.
  Future<void> markExhausted() => _box.put('s_${dayKey()}', searchCap);

  Future<void> setSearchCap(int cap) =>
      HiveBoxes.box(HiveBoxes.settings).put('search_cap', cap);
}

final Provider<QuotaLedger> quotaLedgerProvider = Provider<QuotaLedger>(
  (ref) => QuotaLedger(HiveBoxes.box(HiveBoxes.quota)),
);
SONGLY_EOF

echo "    lib/core/network/rate_limit_interceptor.dart"
cat > lib/core/network/rate_limit_interceptor.dart <<'SONGLY_EOF'
import 'dart:async';

import 'package:dio/dio.dart';

/// Serialises outgoing requests so we never exceed MusicBrainz's hard limit of
/// one request per second. Requests queue up politely instead of racing and
/// earning us a 503 / IP block.
///
/// The lock is held only until the request is *dispatched*, not until the
/// response arrives, so throughput stays at ~1 req/s rather than 1 round-trip/s.
class RateLimitInterceptor extends Interceptor {
  RateLimitInterceptor({this.minGap = const Duration(milliseconds: 1100)});

  final Duration minGap;

  Future<void> _tail = Future<void>.value();
  DateTime _last = DateTime.fromMillisecondsSinceEpoch(0);

  @override
  Future<void> onRequest(
    RequestOptions options,
    RequestInterceptorHandler handler,
  ) async {
    final Completer<void> gate = Completer<void>();
    final Future<void> previous = _tail;
    _tail = gate.future;
    try {
      await previous;
      final Duration wait = minGap - DateTime.now().difference(_last);
      if (wait > Duration.zero) {
        await Future<void>.delayed(wait);
      }
      _last = DateTime.now();
      handler.next(options);
    } finally {
      if (!gate.isCompleted) gate.complete();
    }
  }
}

/// Retries 503 (rate limited) and 429 with backoff, honouring Retry-After.
class BackoffInterceptor extends Interceptor {
  BackoffInterceptor({this.maxRetries = 3});

  final int maxRetries;

  @override
  Future<void> onError(
    DioException err,
    ErrorInterceptorHandler handler,
  ) async {
    final int? status = err.response?.statusCode;
    final bool retryable = status == 503 || status == 429 || status == 500;
    final int attempt = (err.requestOptions.extra['retry_attempt'] as int?) ?? 0;

    if (!retryable || attempt >= maxRetries) {
      handler.next(err);
      return;
    }

    final String? retryAfter =
        err.response?.headers.value('retry-after');
    final Duration delay = retryAfter != null
        ? Duration(seconds: int.tryParse(retryAfter) ?? 2)
        : Duration(milliseconds: 700 * (1 << attempt) + attempt * 150);

    await Future<void>.delayed(delay);

    final RequestOptions retryOptions = err.requestOptions
      ..extra['retry_attempt'] = attempt + 1;

    try {
      final Response<dynamic> response =
          await Dio().fetch<dynamic>(retryOptions);
      handler.resolve(response);
    } on DioException catch (e) {
      handler.next(e);
    }
  }
}
SONGLY_EOF

echo "    lib/core/network/user_agent_interceptor.dart"
cat > lib/core/network/user_agent_interceptor.dart <<'SONGLY_EOF'
import 'package:dio/dio.dart';
import 'package:flutter/foundation.dart' show kIsWeb;

import '../config/env.dart';

/// MusicBrainz requires a descriptive User-Agent. Browsers forbid setting it,
/// so on web we skip it and rely on tools/mb_proxy.dart to inject it instead.
class UserAgentInterceptor extends Interceptor {
  @override
  void onRequest(
    RequestOptions options,
    RequestInterceptorHandler handler,
  ) {
    if (!kIsWeb) {
      options.headers['User-Agent'] = Env.userAgent;
    }
    handler.next(options);
  }
}
SONGLY_EOF

echo "    lib/core/storage/hive_boxes.dart"
cat > lib/core/storage/hive_boxes.dart <<'SONGLY_EOF'
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:hive_ce_flutter/hive_ce_flutter.dart';

/// All local storage in one place. Boxes hold plain JSON-able maps in M0 so we
/// need zero code generation to get a green build.
class HiveBoxes {
  const HiveBoxes._();

  /// recording MBID -> {videoId, score, candidates, resolvedAt, unplayable}
  static const String resolver = 'resolver';

  /// artist MBID -> {channelId, uploadsPlaylistId, source}
  static const String artistChannels = 'artist_channels';

  /// artist MBID -> {normalizedTitle: videoId, ...} (harvested catalogue)
  static const String artistCatalog = 'artist_catalog';

  /// request URL -> {ts, body} HTTP cache (MusicBrainz + YouTube reads)
  static const String httpCache = 'http_cache';

  static const String liked = 'liked';
  static const String playlists = 'playlists';
  static const String history = 'history';
  static const String settings = 'settings';

  /// 's_yyyy-MM-dd' -> searches used, 'u_yyyy-MM-dd' -> cheap units used
  static const String quota = 'quota';

  static const List<String> all = <String>[
    resolver,
    artistChannels,
    artistCatalog,
    httpCache,
    liked,
    playlists,
    history,
    settings,
    quota,
  ];

  /// Boxes that are pure cache and safe to nuke from Settings.
  static const List<String> caches = <String>[httpCache, artistCatalog];

  static Future<void> init() async {
    await Hive.initFlutter('songly');
    for (final String name in all) {
      await Hive.openBox<dynamic>(name);
    }
  }

  static Box<dynamic> box(String name) => Hive.box<dynamic>(name);

  static Future<void> clearCaches() async {
    for (final String name in caches) {
      await box(name).clear();
    }
  }
}

final Provider<Box<dynamic>> settingsBoxProvider =
    Provider<Box<dynamic>>((ref) => HiveBoxes.box(HiveBoxes.settings));

final Provider<Box<dynamic>> resolverBoxProvider =
    Provider<Box<dynamic>>((ref) => HiveBoxes.box(HiveBoxes.resolver));
SONGLY_EOF

echo "    lib/core/utils/debouncer.dart"
cat > lib/core/utils/debouncer.dart <<'SONGLY_EOF'
import 'dart:async';

/// Search-as-you-type without hammering MusicBrainz.
class Debouncer {
  Debouncer({this.delay = const Duration(milliseconds: 400)});

  final Duration delay;
  Timer? _timer;

  void run(void Function() action) {
    _timer?.cancel();
    _timer = Timer(delay, action);
  }

  void cancel() => _timer?.cancel();
  void dispose() => _timer?.cancel();
}
SONGLY_EOF

echo "    lib/core/utils/formatters.dart"
cat > lib/core/utils/formatters.dart <<'SONGLY_EOF'
/// Duration + label helpers.
class Fmt {
  const Fmt._();

  /// 214000 -> "3:34"
  static String duration(int? ms) {
    if (ms == null || ms <= 0) return '--:--';
    final int total = ms ~/ 1000;
    final int h = total ~/ 3600;
    final int m = (total % 3600) ~/ 60;
    final int s = total % 60;
    final String ss = s.toString().padLeft(2, '0');
    if (h > 0) return '$h:${m.toString().padLeft(2, '0')}:$ss';
    return '$m:$ss';
  }

  /// YouTube returns ISO-8601 durations: "PT3M34S" -> Duration.
  static Duration? parseIso8601(String? iso) {
    if (iso == null || iso.isEmpty) return null;
    final RegExpMatch? m = RegExp(
      r'^P(?:(\d+)D)?T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$',
    ).firstMatch(iso);
    if (m == null) return null;
    return Duration(
      days: int.tryParse(m.group(1) ?? '0') ?? 0,
      hours: int.tryParse(m.group(2) ?? '0') ?? 0,
      minutes: int.tryParse(m.group(3) ?? '0') ?? 0,
      seconds: int.tryParse(m.group(4) ?? '0') ?? 0,
    );
  }

  static String greeting([DateTime? now]) {
    final int h = (now ?? DateTime.now()).hour;
    if (h < 12) return 'Good morning';
    if (h < 17) return 'Good afternoon';
    return 'Good evening';
  }
}
SONGLY_EOF

echo "    lib/core/utils/text_normalizer.dart"
cat > lib/core/utils/text_normalizer.dart <<'SONGLY_EOF'
/// Title matching helpers used by the resolver (M3) to decide whether a YouTube
/// video really is the song MusicBrainz told us about.
class TextNormalizer {
  const TextNormalizer._();

  static final RegExp _brackets = RegExp(r'\(.*?\)|\[.*?\]');
  static final RegExp _featuring = RegExp(r'\b(feat|ft|with)\.?\s.*');
  static final RegExp _noise = RegExp(
    r'\b(official|audio|video|lyrics?|lyrical|hd|4k|full|song|mv|m/v)\b',
  );
  static final RegExp _nonAlnum = RegExp(r'[^a-z0-9\s]');
  static final RegExp _spaces = RegExp(r'\s+');

  static String normalize(String input) => input
      .toLowerCase()
      .replaceAll(_brackets, ' ')
      .replaceAll(_featuring, ' ')
      .replaceAll(_noise, ' ')
      .replaceAll(_nonAlnum, ' ')
      .replaceAll(_spaces, ' ')
      .trim();

  static Set<String> tokens(String input) =>
      normalize(input).split(' ').where((String t) => t.isNotEmpty).toSet();

  /// Jaccard-ish token overlap in 0..1.
  static double similarity(String a, String b) {
    final Set<String> ta = tokens(a);
    final Set<String> tb = tokens(b);
    if (ta.isEmpty || tb.isEmpty) return 0;
    final int inter = ta.intersection(tb).length;
    return inter / (ta.length + tb.length - inter);
  }

  static const List<String> negativeKeywords = <String>[
    'live', 'cover', 'karaoke', 'remix', 'reaction', 'slowed', 'reverb',
    'nightcore', '8d', 'instrumental', 'mashup', 'tutorial', 'reversed',
  ];

  static bool looksLikeWrongVersion(String title) {
    final String n = normalize(title);
    return negativeKeywords.any((String k) => n.contains(k));
  }
}
SONGLY_EOF

