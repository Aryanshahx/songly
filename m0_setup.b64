echo "    tools/mb_proxy.dart"
cat > tools/mb_proxy.dart <<'SONGLY_EOF'
// Dev-only helper for the Raspberry Pi.
//
// Browsers refuse to let Flutter web set a User-Agent header, but MusicBrainz
// requires one. Run this proxy while developing in Chromium:
//
//   dart run tools/mb_proxy.dart
//   flutter run -d chrome --dart-define-from-file=dart_define.json \
//     --dart-define=MB_BASE_URL=http://localhost:8787/ws/2
//
// It also adds CORS headers so the browser stops complaining.
import 'dart:io';

Future<void> main(List<String> args) async {
  const int port = 8787;
  const String contact = 'you@example.com'; // <- put your real contact here
  final HttpClient client = HttpClient();
  final HttpServer server = await HttpServer.bind(InternetAddress.anyIPv4, port);
  stdout.writeln('MusicBrainz dev proxy on http://localhost:$port');

  await for (final HttpRequest req in server) {
    try {
      if (req.method == 'OPTIONS') {
        _cors(req.response);
        await req.response.close();
        continue;
      }
      final Uri target = Uri.parse(
        'https://musicbrainz.org${req.uri.path}'
        '${req.uri.hasQuery ? '?${req.uri.query}' : ''}',
      );
      final HttpClientRequest forward = await client.getUrl(target);
      forward.headers.set('User-Agent', 'Songly-dev/1.0 ( $contact )');
      forward.headers.set('Accept', 'application/json');
      final HttpClientResponse upstream = await forward.close();

      _cors(req.response);
      req.response.statusCode = upstream.statusCode;
      req.response.headers.contentType = ContentType.json;
      await upstream.pipe(req.response);
    } catch (e) {
      _cors(req.response);
      req.response.statusCode = HttpStatus.badGateway;
      req.response.write('{"error":"$e"}');
      await req.response.close();
    }
  }
}

void _cors(HttpResponse res) {
  res.headers
    ..set('Access-Control-Allow-Origin', '*')
    ..set('Access-Control-Allow-Headers', '*')
    ..set('Access-Control-Allow-Methods', 'GET,OPTIONS');
}
SONGLY_EOF


