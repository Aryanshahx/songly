import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../../app/theme/app_theme.dart';

/// Placeholder for "what is playing right now".
/// M3 replaces this with the real PlayerHost notifier (keepAlive) that owns the
/// single YoutubePlayerController.
final Provider<PlayingStub?> currentTrackProvider =
    Provider<PlayingStub?>((ref) => null);

class PlayingStub {
  const PlayingStub({required this.title, required this.artist});

  final String title;
  final String artist;
}

/// Docked mini player.
///
/// M0: renders nothing until something is playing, but it IS mounted inside the
/// router shell - that is the whole point.
/// M3: the ONE `YoutubePlayer` widget lives here, rendered as a small visible
/// 16:9 tile (never Offstage - hidden webviews get throttled and the iFrame
/// terms expect a visible embed). Tapping expands to the Now Playing screen.
class MiniPlayer extends ConsumerWidget {
  const MiniPlayer({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final PlayingStub? track = ref.watch(currentTrackProvider);
    if (track == null) {
      return const SizedBox.shrink();
    }

    return Container(
      height: 64,
      margin: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
      padding: const EdgeInsets.only(right: 8),
      decoration: BoxDecoration(
        color: AppColors.surfaceHigh,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Row(
        children: <Widget>[
          // ---- M3: YoutubePlayer goes in this slot ----
          Container(
            width: 96,
            height: 54,
            decoration: BoxDecoration(
              color: Colors.black,
              borderRadius: BorderRadius.circular(8),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: <Widget>[
                Text(
                  track.title,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(fontWeight: FontWeight.w700),
                ),
                Text(
                  track.artist,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    color: AppColors.textDim,
                    fontSize: 12,
                  ),
                ),
              ],
            ),
          ),
          IconButton(
            icon: const Icon(Icons.play_arrow_rounded),
            onPressed: () {},
          ),
        ],
      ),
    );
  }
}
SONGLY_EOF

echo "    lib/features/resolver/domain/resolver_strategy.dart"
cat > lib/features/resolver/domain/resolver_strategy.dart <<'SONGLY_EOF'
/// The resolver turns a MusicBrainz recording into a playable YouTube videoId.
///
/// It is deliberately a CHAIN of pluggable strategies, tried cheapest-first, so
/// the expensive one (keyword search) is the last resort and can be swapped or
/// disabled without touching the rest of the app.
///
/// Implementations land in M3:
///   1. CacheStrategy          - Hive `resolver` box, 0 cost, permanent
///   2. MusicBrainzRelStrategy - MB "free streaming" url-rels, 0 cost
///   3. ArtistCatalogStrategy  - fuzzy match against a harvested catalogue, 0 cost
///   4. CatalogHarvestStrategy - channels.list + playlistItems.list (~1 unit/50 videos)
///   5. SearchStrategy         - search.list, budget-gated (the scarce resource)
///   6. ManualStrategy         - user picks from stored candidates, 0 cost
class ResolveRequest {
  const ResolveRequest({
    required this.recordingMbid,
    required this.title,
    required this.artistName,
    this.artistMbid,
    this.durationMs,
  });

  final String recordingMbid;
  final String title;
  final String artistName;
  final String? artistMbid;
  final int? durationMs;
}

class ResolveResult {
  const ResolveResult({
    required this.videoId,
    required this.score,
    required this.source,
    this.candidates = const <String>[],
  });

  final String videoId;
  final double score;

  /// Which strategy produced this, for the debug/quota screen.
  final String source;

  /// Extra candidates from the same paid search, so "wrong song?" costs nothing.
  final List<String> candidates;
}

abstract interface class ResolverStrategy {
  String get name;

  /// Whether this strategy can run right now (e.g. search respects the budget).
  Future<bool> canRun(ResolveRequest request);

  /// Returns null to fall through to the next strategy.
  Future<ResolveResult?> resolve(ResolveRequest request);
}
SONGLY_EOF

