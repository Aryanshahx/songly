#!/usr/bin/env bash
# ==========================================================================
#  Songly - M0 Foundations installer
#  Run this from the ROOT of your existing Flutter project (where pubspec.yaml
#  lives), in the IntelliJ terminal:
#
#      bash m0_setup.sh
#
#  It is safe to re-run. It adds packages, writes lib/ files, patches the
#  Android manifest, then analyzes. NOTHING here needs code generation, so you
#  get a green build immediately.
# ==========================================================================
set -euo pipefail

if [ ! -f pubspec.yaml ]; then
  echo "ERROR: no pubspec.yaml here. cd into your Songly project root first."
  exit 1
fi

echo "==> Flutter version (pin this exact version in codemagic.yaml)"
flutter --version

echo "==> Trimming platforms: Android (release) + Web (fast dev on the Pi)"
flutter config --no-enable-ios --no-enable-macos-desktop \
               --no-enable-windows-desktop --no-enable-linux-desktop >/dev/null
flutter config --enable-web >/dev/null

echo "==> Adding runtime packages"
flutter pub add \
  flutter_riverpod riverpod_annotation \
  dio go_router \
  youtube_player_iframe \
  hive_ce hive_ce_flutter path_provider \
  cached_network_image palette_generator \
  connectivity_plus share_plus url_launcher intl \
  freezed_annotation json_annotation collection uuid

echo "==> Adding dev packages (codegen starts in M1)"
flutter pub add --dev \
  build_runner freezed json_serializable \
  riverpod_generator riverpod_lint custom_lint flutter_lints

echo "==> Creating folders"
mkdir -p lib/app/theme
mkdir -p lib/core/config lib/core/network lib/core/storage lib/core/errors lib/core/utils
mkdir -p lib/shared/widgets
mkdir -p lib/features/search/data lib/features/search/domain lib/features/search/presentation
mkdir -p lib/features/album/data lib/features/album/domain lib/features/album/presentation
mkdir -p lib/features/artist/data lib/features/artist/domain lib/features/artist/presentation
mkdir -p lib/features/player/data lib/features/player/domain lib/features/player/presentation
mkdir -p lib/features/resolver/data lib/features/resolver/domain lib/features/resolver/presentation
mkdir -p lib/features/library/data lib/features/library/domain lib/features/library/presentation
mkdir -p lib/features/home/data lib/features/home/domain lib/features/home/presentation
mkdir -p lib/features/lyrics/data lib/features/lyrics/domain lib/features/lyrics/presentation
mkdir -p lib/features/settings/presentation
mkdir -p tools

echo "==> Writing files"
echo "    analysis_options.yaml"
cat > analysis_options.yaml <<'SONGLY_EOF'
include: package:flutter_lints/flutter.yaml

analyzer:
  errors:
    invalid_annotation_target: ignore
  exclude:
    - "**/*.g.dart"
    - "**/*.freezed.dart"

linter:
  rules:
    prefer_single_quotes: true
    always_declare_return_types: true
    avoid_print: true
    require_trailing_commas: true
    use_super_parameters: true
SONGLY_EOF

echo "    codemagic.yaml"
cat > codemagic.yaml <<'SONGLY_EOF'
# Songly CI. Pin `flutter:` to whatever `flutter --version` prints on your Pi.
definitions:
  env_versions: &env_versions
    flutter: 3.44.9
    java: 21
  scripts:
    - &write_env
      name: Write dart_define.json from Codemagic env vars
      script: |
        cat > dart_define.json <<JSON
        {
          "YT_API_KEY": "$YT_API_KEY",
          "MB_CONTACT": "$MB_CONTACT",
          "APP_VERSION": "$FCI_BUILD_ID"
        }
        JSON
    - &pub_get
      name: Dependencies
      script: flutter pub get
    - &analyze
      name: Analyze
      script: flutter analyze --no-fatal-infos

workflows:
  android-debug:
    name: Songly Android (debug APK)
    instance_type: linux_x2
    max_build_duration: 45
    environment:
      <<: *env_versions
      groups:
        - songly_secrets   # YT_API_KEY (secure), MB_CONTACT
    triggering:
      events:
        - push
      branch_patterns:
        - pattern: dev
          include: true
        - pattern: 'feat/*'
          include: true
    scripts:
      - *write_env
      - *pub_get
      - *analyze
      - name: Build debug APK
        script: |
          flutter build apk --debug \
            --dart-define-from-file=dart_define.json
    artifacts:
      - build/**/outputs/**/*.apk
    publishing:
      email:
        recipients:
          - you@example.com
        notify:
          success: true
          failure: true

  android-release:
    name: Songly Android (release AAB + APK)
    instance_type: linux_x2
    max_build_duration: 60
    environment:
      <<: *env_versions
      groups:
        - songly_secrets
      android_signing:
        - songly_keystore   # upload your keystore in Codemagic first (M8)
    triggering:
      events:
        - tag
      tag_patterns:
        - pattern: 'v*'
          include: true
    scripts:
      - *write_env
      - *pub_get
      - *analyze
      - name: Build release
        script: |
          flutter build apk --release \
            --dart-define-from-file=dart_define.json
          flutter build appbundle --release \
            --dart-define-from-file=dart_define.json
    artifacts:
      - build/**/outputs/**/*.apk
      - build/**/outputs/**/*.aab
    publishing:
      email:
        recipients:
          - you@example.com
SONGLY_EOF

echo "    lib/app/app.dart"
cat > lib/app/app.dart <<'SONGLY_EOF'
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'router.dart';
import 'theme/app_theme.dart';

class SonglyApp extends ConsumerWidget {
  const SonglyApp({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    return MaterialApp.router(
      title: 'Songly',
      debugShowCheckedModeBanner: false,
      theme: AppTheme.dark(),
      darkTheme: AppTheme.dark(),
      themeMode: ThemeMode.dark,
      routerConfig: ref.watch(routerProvider),
    );
  }
}
SONGLY_EOF

echo "    lib/app/router.dart"
cat > lib/app/router.dart <<'SONGLY_EOF'
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';

import '../features/home/presentation/home_screen.dart';
import '../features/library/presentation/library_screen.dart';
import '../features/search/presentation/search_screen.dart';
import '../features/settings/presentation/settings_screen.dart';
import '../shared/widgets/app_shell.dart';

/// Routes. The three tabs live inside a [StatefulShellRoute] so each tab keeps
/// its own navigation state AND — critically — the mini player in [AppShell] is
/// never rebuilt/disposed when you switch tabs. That is what will keep the
/// YouTube iFrame webview alive across navigation in M3.
final routerProvider = Provider<GoRouter>((ref) {
  return GoRouter(
    initialLocation: '/home',
    debugLogDiagnostics: true,
    routes: <RouteBase>[
      StatefulShellRoute.indexedStack(
        builder: (context, state, navigationShell) =>
            AppShell(shell: navigationShell),
        branches: <StatefulShellBranch>[
          StatefulShellBranch(
            routes: <RouteBase>[
              GoRoute(
                path: '/home',
                builder: (context, state) => const HomeScreen(),
              ),
            ],
          ),
          StatefulShellBranch(
            routes: <RouteBase>[
              GoRoute(
                path: '/search',
                builder: (context, state) => const SearchScreen(),
              ),
            ],
          ),
          StatefulShellBranch(
            routes: <RouteBase>[
              GoRoute(
                path: '/library',
                builder: (context, state) => const LibraryScreen(),
              ),
            ],
          ),
        ],
      ),
      GoRoute(
        path: '/settings',
        builder: (context, state) => const SettingsScreen(),
      ),
    ],
  );
});
SONGLY_EOF

